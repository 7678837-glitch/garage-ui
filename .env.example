# Copy to .env and fill all four values before connecting to an existing Garage.
# URLs must be reachable from the UI container, not only from your browser.
GARAGE_ADMIN_URL=
GARAGE_ADMIN_TOKEN=
S3_ENDPOINT_URL=
S3_REGION=

# Optional: browser-reachable S3 URL for expiring share links.
# S3_PUBLIC_ENDPOINT_URL=

# Secure cookies are enabled by default. Keep this default for HTTPS.
# For explicitly local HTTP only, set COOKIE_SECURE=false when starting Compose.
# COOKIE_SECURE=true
